# k3s deployment settings
DEPLOYMENT_NAMESPACE=cert-expire-notifier
DEPLOYMENT_APP_NAME=cert-expire-notifier
DEPLOYMENT_SERVICE_NAME=cert-expire-notifier-service
DEPLOYMENT_SECRET_NAME=cert-expire-notifier-secret
DEPLOYMENT_IMAGE=ghcr.io/your-org/cert-expire-notifier:latest
DEPLOYMENT_IMAGE_PULL_SECRET=
DEPLOYMENT_REPLICAS=1
DEPLOYMENT_CONTAINER_PORT=3000
DEPLOYMENT_NODE_PORT=25334
DEPLOYMENT_RUN_MIGRATIONS=true
DEPLOYMENT_CREATE_MYSQL=true
DEPLOYMENT_MYSQL_NAME=cert-expire-notifier-mysql
DEPLOYMENT_MYSQL_SERVICE_NAME=cert-expire-notifier-mysql
DEPLOYMENT_MYSQL_SECRET_NAME=cert-expire-notifier-mysql-secret
DEPLOYMENT_MYSQL_IMAGE=mysql:8.4
DEPLOYMENT_MYSQL_PORT=3306
DEPLOYMENT_MYSQL_STORAGE_SIZE=10Gi
DEPLOYMENT_MYSQL_STORAGE_CLASS=

# Optional image registry credentials
GHCR_USERNAME=
GHCR_TOKEN=

# Application settings
APP_VERSION=0.1.0
NODE_ENV=production
SITE=new
PORT=3000
JWT_SECRET=replace-with-a-secure-secret
TZ=UTC

# In-cluster MySQL settings
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=cert-expire-notifier
MYSQL_USER=cert_expire_notifier
MYSQL_PASSWORD=replace-with-a-strong-app-password

# Optional override. If empty, deploy.sh will generate DATABASE_URL from the MySQL settings above.
DATABASE_URL=

# EngageLab Email
ENGAGE_LAB_USERNAME=your-username
ENGAGE_LAB_API_KEY=your-api-key
ENGAGE_LAB_FROM_EMAIL=noreply@example.com

# Healthchecks.io
HEALTHCHECKS_PING_URL=

# Cert check interval (cron expression, default: every hour)
CERT_CHECK_CRON=0 * * * *

# Optional comma-separated proxy fallback list for cert checks.
# Examples: http://proxy.example.com:7890,socks5://user:pass@proxy.example.com:1080
CERT_CHECK_PROXY_URLS=

# Expiry threshold in days
CERT_EXPIRY_THRESHOLD_DAYS=30
